*.profraw
harnesses/jev-loop/*.jsonl

# Python (Laya server)
__pycache__/
*.pyc
.venv/

# Node tooling
node_modules/

# Local-only material: pre-rebrand decks/reports and the demo-video workspace
docs/*.pdf
docs/*.pptx
docs/demo-video/

# Local agent settings
.claude/settings.local.json
